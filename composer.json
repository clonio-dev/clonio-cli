{
    "name": "clonio-dev/clonio-cli",
    "description": "The clonio application",
    "homepage": "https://clonio.dev",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/clonio-dev/clonio-cli/issues",
        "source": "https://github.com/clonio-dev/clonio-cli"
    },
    "authors": [
        {
            "name": "Robert Kummer",
            "email": "post@robert-kummer.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel-zero/framework": "^12.0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.29.0",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["clonio"]
}
