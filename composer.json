{
    "name": "clonio-dev/clonio-cli",
    "description": "The clonio application",
    "homepage": "https://clonio.dev",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "cli",
        "database",
        "anonymization",
        "gdpr",
        "data-privacy",
        "database-transfer",
        "fake-data",
        "production-to-dev",
        "laravel-zero",
        "devops",
        "database-cloning",
        "data-masking",
        "dev",
        "testing"
    ],
    "support": {
        "issues": "https://github.com/clonio-dev/clonio-cli/issues",
        "source": "https://github.com/clonio-dev/clonio-cli"
    },
    "authors": [
        {
            "name": "Robert Kummer",
            "email": "post@robert-kummer.de"
        }
    ],
    "require": {
        "php": "^8.5",
        "fakerphp/faker": "^1.24.1",
        "illuminate/database": "^13.37",
        "illuminate/encryption": "^13.37",
        "illuminate/http": "^13.37",
        "illuminate/log": "^13.37",
        "laravel-zero/framework": "^13.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "mpdf/mpdf": "^8.3.1",
        "symfony/yaml": "^8.1.9"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.13.0",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-type-coverage": "^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "./clonio app:build clonio --no-interaction",
        "update:requirements": "composer bump",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=99",
        "test:unit": "pest --parallel --coverage --min=95",
        "test:types": "phpstan",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:mutate": "pest --mutate --covered-only",
        "test:mutate:all": "pest --mutate --everything --covered-only --parallel --no-cache --min=100",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:types",
            "@test:lint"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts-descriptions": {
        "test:mutate:all": "Mutation testing for the whole app, fails below a 100% score",
        "test:mutate": "Mutation testing for selected code, e.g. composer test:mutate -- --path=app/Services/Cloning/FrameworkTableCatalog.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["clonio"]
}
