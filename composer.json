{
    "name": "clonio-dev/clonio-cli",
    "version": "0.4.0",
    "description": "The clonio application",
    "homepage": "https://clonio.dev",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/clonio-dev/clonio-cli/issues",
        "source": "https://github.com/clonio-dev/clonio-cli"
    },
    "authors": [
        {
            "name": "Robert Kummer",
            "email": "post@robert-kummer.de"
        }
    ],
    "require": {
        "php": "^8.5",
        "fakerphp/faker": "^1.24",
        "illuminate/database": "^12.17",
        "illuminate/encryption": "^12.56",
        "illuminate/http": "^12.17",
        "illuminate/log": "^12.17",
        "laravel-zero/framework": "^12.1.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.2",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29.0",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.4.3",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "./clonio app:build clonio --no-interaction",
        "update:requirements": "composer bump",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=90",
        "test:unit": "pest --parallel --coverage --min=75",
        "test:types": "phpstan",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:types",
            "@test:lint"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["builds/clonio"]
}
